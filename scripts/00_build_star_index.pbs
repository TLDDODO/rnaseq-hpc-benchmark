#!/bin/bash
#PBS -P personal-e1546946
#PBS -N star_index
#PBS -j oe
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=8:mem=40gb

module load STAR/2.7.11b-GCC-12.3.0

GENOME=/scratch/e1546946/phm5004/ref/genome/Homo_sapiens.GRCh38.dna.primary_assembly.fa
GTF=/scratch/e1546946/phm5004/ref/gtf/Homo_sapiens.GRCh38.109.gtf
INDEX=/scratch/e1546946/phm5004/ref/star_index

STAR \
  --runMode genomeGenerate \
  --genomeDir $INDEX \
  --genomeFastaFiles $GENOME \
  --sjdbGTFfile $GTF \
  --sjdbOverhang 149 \
  --runThreadN 8 \
  --genomeSAindexNbases 14
